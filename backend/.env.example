# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_key_here

# Models (override if a name is not available for your key/region)
CHAT_MODEL=gemini-3.1-flash-lite
# VISION_MODEL defaults to CHAT_MODEL; it must accept image input.
# VISION_MODEL=gemini-3.1-flash-lite

# Embeddings: "local" (ONNX model on this machine, no quota; ~200 MB one-time
# download) or "gemini" (API). The free Gemini tier allows ~100 embedded texts
# per minute and a daily cap, which a 200-page report alone can approach.
# Switching provider requires clearing the knowledge base and re-uploading.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Client-side pacing for the free tier
EMBED_RPM=90
GEN_RPM=14

# Chunking
CHUNK_TARGET=900
CHUNK_MAX=1400
PARENT_MAX=3500

# Chart transcription: off | auto | all
VISION_MODE=auto
VISION_MAX_PAGES=30

# Retrieval
TOP_K=8
CANDIDATES=40
HYBRID=on
QUERY_SCOPING=on
RERANK=llm
RERANK_TOP=20
CONTEXT_CHAR_BUDGET=12000
GROUNDING_CHECK=on
# Only used when RERANK=off
RELEVANCE_THRESHOLD=0.60

MAX_FILE_SIZE_MB=30
